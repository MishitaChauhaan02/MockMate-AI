# Mockmate AI — Master Environment Configuration

# Database: SQLite for instant local dev, or PostgreSQL for production / Docker
DATABASE_URL=sqlite:///./mockmate.db
# PostgreSQL Docker example:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/mockmate_db

# Security
SECRET_KEY=mockmate-ai-super-secret-key-change-in-production-2026

# AI Engine (OpenAI)
# Optional for local test (built-in semantic heuristic fallback is enabled if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# URLs & Ports
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api
